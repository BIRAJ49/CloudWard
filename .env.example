# CloudWard application
APP_ENV=development
APP_NAME=CloudWard
APP_VERSION=0.5.0
DEBUG=false
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=3000
CLOUDWARD_PORT=8080
AWS_REGION=eu-north-1

# Replace every placeholder below before starting the stack.
POSTGRES_DB=cloudward
POSTGRES_USER=cloudward
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://cloudward:replace-me@postgres:5432/cloudward
REDIS_URL=redis://redis:6379/0
OPA_URL=http://opa:8181
OPA_CHAOS_DECISION_PATH=/v1/data/cloudward/chaos/decision

# Authentication. Never enable development authentication outside development.
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
SESSION_SECRET=replace-me-with-at-least-32-random-characters
TEAMS_WEBHOOK_URL=
# The Compose stack is explicitly development-only. This bypass is rejected by
# backend startup in staging and production, where GitHub OAuth is mandatory.
DEV_AUTH_ENABLED=true

# Browser/API policy
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Outbound-only cluster evidence agent. Register inventory before enabling.
CLUSTER_AGENT_ENABLED=false
CLUSTER_AGENT_CLUSTER_ID=
CLUSTER_AGENT_TOKEN=
CLUSTER_AGENT_FRESHNESS_SECONDS=180

# Local Kubernetes target
KUBERNETES_CONTEXT=k3d-cloudward
KUBECONFIG=.k3d/cloudward-kubeconfig.yaml
KUBERNETES_ALLOWED_NAMESPACES=cloudward-staging
DEMO_SERVICE_NAME=cloudward-demo
DEMO_DEPLOYMENT_NAME=cloudward-demo

# Part 2 observability and bounded evidence collection. The local k3d bootstrap
# exposes these endpoints only to the host/control plane.
ALERTMANAGER_WEBHOOK_TOKEN=replace-me-with-at-least-32-random-characters
WORKER_INTERNAL_TOKEN=replace-me-with-a-different-32-character-token
PROMETHEUS_URL=http://host.docker.internal:9090
LOKI_URL=http://host.docker.internal:3100
TEMPO_URL=http://host.docker.internal:3200
TELEMETRY_TIMEOUT_SECONDS=5
TELEMETRY_MAX_SAMPLES=200
EVIDENCE_BEFORE_SECONDS=300
EVIDENCE_AFTER_SECONDS=300
ALERT_REPLAY_TOLERANCE_SECONDS=300

# Incident Lab safety limits. The API rejects other namespaces and requires
# the exact demo-target label before creating any Chaos Mesh resource.
INCIDENT_LAB_NAMESPACE=cloudward-staging
INCIDENT_LAB_REQUIRED_LABEL=cloudward.io/demo-target=true
CHAOS_MAX_RUNTIME_SECONDS=300
MAX_TEMPORARY_REPLICAS=5
AUTOMATIC_ROLLBACK_MAX_RISK=30

# R1 uses only this loopback-exposed ephemeral k3d repository. The backend
# rejects any other repository, branch, values path, or non-local environment.
LOCAL_GITOPS_WRITE_ENABLED=true
LOCAL_GITOPS_REPO_URL=git://host.docker.internal:19418/cloudward-gitops.git
LOCAL_GITOPS_TIMEOUT_SECONDS=20

# Runtime-security ingestion and verified, reversible Cilium quarantine.
TETRAGON_WEBHOOK_SECRET=replace-me-with-at-least-32-random-characters
TETRAGON_WEBHOOK_MAX_BODY_BYTES=131072
TETRAGON_WEBHOOK_MAX_EVENTS_PER_MINUTE=120
TETRAGON_WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
SECURITY_DEDUP_WINDOW_SECONDS=60
SECURITY_QUARANTINE_VERIFY_TIMEOUT_SECONDS=30
SECURITY_QUARANTINE_VERIFY_POLL_SECONDS=1
OPENCOST_URL=http://host.docker.internal:9003
FINOPS_PROVIDER_TIMEOUT_SECONDS=8
FINOPS_MAX_RESPONSE_BYTES=1048576
FINOPS_MAX_SAMPLES=1000
FINOPS_DEMO_OBSERVATION_WINDOW_SECONDS=1800
FINOPS_DEMO_MINIMUM_WINDOW_SECONDS=900
FINOPS_PRODUCTION_MINIMUM_WINDOW_SECONDS=604800
FINOPS_QUERY_STEP_SECONDS=60
FINOPS_MINIMUM_SAMPLES=5
FINOPS_MINIMUM_WINDOW_COVERAGE=0.8
FINOPS_CPU_HEADROOM_FACTOR=1.5
FINOPS_MEMORY_HEADROOM_FACTOR=1.35
FINOPS_MINIMUM_CPU_MILLICORES=50
FINOPS_MINIMUM_MEMORY_MIB=64
FINOPS_MINIMUM_REDUCTION_PERCENT=20
FINOPS_NODE_REQUEST_THRESHOLD=0.45
FINOPS_NODE_USAGE_THRESHOLD=0.35
FINOPS_RECOMMENDATION_TTL_SECONDS=86400
FINOPS_DEMO_NAMESPACE=cloudward-staging
FINOPS_DEMO_DEPLOYMENT=cloudward-demo
FINOPS_DEMO_POD_PATTERN=cloudward-demo-.*
FINOPS_GITOPS_REPOSITORY=biraj49/cloudward-gitops
FINOPS_GITOPS_VALUES_PATH=cloudward-gitops/environments/staging/values.yaml
APPROVAL_TTL_SECONDS=1800
TEAMS_WORKFLOW_WEBHOOK_URL=
TEAMS_DASHBOARD_URL=http://localhost:8080
NOTIFICATION_TIMEOUT_SECONDS=8
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_EVENTS=critical_incident_detected,approval_required,security_containment_executed,remediation_failed,incident_escalated,incident_resolved

# Part 3 advisory diagnosis. AI output is schema-validated and can never execute
# directly. Leave the key empty to exercise deterministic graceful degradation.
CLOUDWARD_AI_DIAGNOSIS_ENABLED=false
CLOUDWARD_LLM_PRIMARY_MODEL=openai/gpt-5.6-terra
CLOUDWARD_LLM_FALLBACK_MODEL=google/gemini-3.5-flash-lite
CLOUDWARD_LLM_ESCALATION_MODEL=openai/gpt-5.6-sol
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=anthropic/claude-3.7-sonnet
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_CONTEXT_TOKENS=16000
AI_MAX_EVIDENCE_CHARS=60000
AI_MAX_MODEL_CALLS_PER_INCIDENT=3
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_WINDOW_SECONDS=300

# GitHub App machine identity. The private key may use literal \n separators.
# Repositories are owner/name CSV values. Writes require a JSON path allowlist.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_READ_REPOSITORIES=
GITHUB_APP_ISSUE_REPOSITORIES=
GITHUB_APP_WRITE_ALLOWLIST={}

# Demo workload OpenTelemetry identity and the internal-only S2 simulator.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
DEPLOYMENT_ENVIRONMENT=staging
SERVICE_VERSION=0.2.0
CLOUDWARD_C2_URL=http://cloudward-c2-simulator.cloudward-staging.svc.cluster.local:8080/observe

# Part 4 EC2 control-plane inventory. Enable only with the configured EKS kube context.
INVENTORY_BOOTSTRAP_ENABLED=false
INVENTORY_CLUSTER_NAME=cloudward-aws
INVENTORY_CLUSTER_CONTEXT=cloudward-eks
INVENTORY_CLUSTER_ENVIRONMENT=production
INVENTORY_AWS_REGION=eu-north-1
