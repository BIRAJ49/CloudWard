# Replace both safety placeholders before planning.
allowed_eks_public_access_cidrs = ["203.0.113.10/32"] # REPLACE with your current public /32.
administrator_principal_arns = [
  "arn:aws:iam::123456789012:role/REPLACE_WITH_TERRAFORM_OPERATOR_ROLE",
]

# Verify current eu-north-1 offerings before plan. These values are examples,
# not claims of availability or adequate always-on capacity.
system_node_instance_types = ["t3.medium", "t3a.medium"]
control_plane_instance_type = "t3.large"

# Current official reference selected for EKS 1.35; recheck before a later plan.
