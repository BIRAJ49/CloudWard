{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "service", "securityContext"],
  "properties": {
    "global": {"type": "object"},
    "replicaCount": {"type": "integer", "minimum": 2},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "requireDigest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "requireDigest": {"type": "boolean"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "sbomReference",
        "securityScan",
        "stagingValidation",
        "rollbackDigest"
      ],
      "properties": {
        "identifier": {"type": "string", "maxLength": 128},
        "sourceCommit": {"type": "string", "maxLength": 64},
        "sbomReference": {"type": "string", "maxLength": 512},
        "securityScan": {"type": "string", "maxLength": 64},
        "stagingValidation": {"type": "string", "maxLength": 64},
        "rollbackDigest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        }
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "demoTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "demoControlAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "existingSecret", "key"],
      "properties": {
        "required": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "publicRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "gatewayName",
        "gatewayNamespace",
        "sectionName",
        "hostnames",
        "paths"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "gatewayName": {"type": "string", "minLength": 1},
        "gatewayNamespace": {"type": "string", "minLength": 1},
        "sectionName": {"type": "string", "minLength": 1},
        "hostnames": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "otlpEndpoint"],
      "properties": {
        "environment": {"enum": ["local", "staging", "production"]},
        "otlpEndpoint": {"type": "string", "minLength": 1}
      }
    },
    "securityScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c2Url"],
      "properties": {"c2Url": {"type": "string", "minLength": 1}}
    },
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "service": {"type": "object"},
    "resources": {"type": "object"},
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "podDisruptionBudget": {"type": "object"},
    "networkPolicy": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  }
}
