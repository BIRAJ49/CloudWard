[Unit]
Description=CloudWard production Docker Compose control plane
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/cloudward
ExecStart=/usr/bin/docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.production.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.production.yml down
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
